# 靶子服务端口登记表（decision 007：注入规则须按端口过滤，各服务端口逐一登记）
# 由 compose 合并配置生成，非人工填写。生成方式：
#   docker compose -f compose.yaml -f compose.observability.yaml \
#     -f compose.override.yaml config  ->  取 <NAME>_PORT 环境变量，
#   并与该服务 ports[].target 交叉核对。
# *_PROMETHEUS_PORT / *_METRICS_PORT 是遥测端口，不是服务端口，已排除。

AD_PORT=9555   # 来源 AD_PORT; ports[].target=[9465, 9555]; 交叉核对=True
ASTRONOMY_DB_PORT=5432   # 来源 ports[].target; ports[].target=[5432]; 交叉核对=True
CART_PORT=7070   # 来源 CART_PORT; ports[].target=[7070]; 交叉核对=True
CHECKOUT_PORT=5050   # 来源 CHECKOUT_PORT; ports[].target=[5050]; 交叉核对=True
CURRENCY_PORT=7001   # 来源 CURRENCY_PORT; ports[].target=[7001]; 交叉核对=True
EMAIL_PORT=6060   # 来源 EMAIL_PORT; ports[].target=[6060]; 交叉核对=True
FLAGD_PORT=None   # 来源 AMBIGUOUS targets=[8013, 8016] env=[]; ports[].target=[8013, 8016]; 交叉核对=None
FRONTEND_PORT=8080   # 来源 ports[].target; ports[].target=[8080]; 交叉核对=True
FRONTEND_PROXY_PORT=None   # 来源 AMBIGUOUS targets=[8080, 10000] env=['CHATBOT_PORT', 'ENVOY_ADMIN_PORT', 'ENVOY_PORT', 'FIREPIT_PORT', 'FLAGD_PORT', 'FLAGD_UI_PORT', 'FRONTEND_PORT', 'GRAFANA_PORT', 'IMAGE_PROVIDER_PORT', 'JAEGER_UI_PORT', 'OPAMP_SERVER_UI_PORT', 'TELEMETRY_DOCS_PORT']; ports[].target=[8080, 10000]; 交叉核对=None
IMAGE_PROVIDER_PORT=8081   # 来源 IMAGE_PROVIDER_PORT; ports[].target=[8081]; 交叉核对=True
PAYMENT_PORT=50051   # 来源 PAYMENT_PORT; ports[].target=[50051]; 交叉核对=True
PRODUCT_CATALOG_PORT=3550   # 来源 PRODUCT_CATALOG_PORT; ports[].target=[3550]; 交叉核对=True
QUOTE_PORT=8090   # 来源 QUOTE_PORT; ports[].target=[8090]; 交叉核对=True
RECOMMENDATION_PORT=9001   # 来源 RECOMMENDATION_PORT; ports[].target=[9001]; 交叉核对=True
SHIPPING_PORT=50050   # 来源 SHIPPING_PORT; ports[].target=[50050]; 交叉核对=True
VALKEY_CART_PORT=6379   # 来源 ports[].target; ports[].target=[6379]; 交叉核对=True
