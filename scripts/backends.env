# 三后端 base URL（宿主机视角）。由 kill_container.sh / three_signals.py 读取。
#
# 注意：jaeger 与 opensearch 用的是 Docker 随机分配的宿主机端口（3xxxx），
# 容器一旦 --force-recreate 端口就会变。重建后用下面这条命令重新生成本文件：
#   docker compose -f compose.yaml -f compose.observability.yaml \
#     -f compose.override.yaml ps --format '{{.Service}} {{.Ports}}'
#
# Jaeger v2 在 base path /jaeger/ui 下提供 API，裸 /api/services 会 404。
# 不走 frontend-proxy(:8080) 是有意的：frontend-proxy 在 target_enum 内，
# 将来被注入时会把探针一起打断。

JAEGER_BASE=http://localhost:32774/jaeger/ui
PROM_BASE=http://localhost:9090
OPENSEARCH_BASE=http://localhost:32801

# 容器内 IP 直连备用（bridge 网络对宿主机可路由）
JAEGER_IP_BASE=http://172.18.0.9:16686/jaeger/ui
PROM_IP_BASE=http://172.18.0.2:9090
OPENSEARCH_IP_BASE=http://172.18.0.10:9200
