# 三后端 base URL（宿主机视角）。由 kill_container.sh / drop_inbound.sh /
# three_signals.py 读取。
#
# 端口已在 compose.override.yaml 中钉死（jaeger 16686、opensearch 9200 均为
# 固定映射），本文件是常量，不需要随容器重建重新生成。
#
# Jaeger v2 在 base path /jaeger/ui 下提供 API，裸 /api/services 会 404。
# 不走 frontend-proxy(:8080) 是有意的：frontend-proxy 在 target_enum 内，
# 将来被注入时会把探针一起打断。

JAEGER_BASE=http://localhost:16686/jaeger/ui
PROM_BASE=http://localhost:9090
OPENSEARCH_BASE=http://localhost:9200
