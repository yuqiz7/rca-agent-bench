 "info": {
  "title": "rca-agent-bench evaluation service",
  "version": "1.0.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/admin/reimport": {
   "post": {
    "description": "Backfill artifacts/agent_runs/ into Postgres. Local, idempotent, re-runnable.\n\n404 rather than 403 when disabled: see config.admin_enabled(). Runs\nsynchronously -- it is a few hundred file reads against a local mount, the\ncaller is a human on a loopback port, and putting it on the queue would make\nthe one endpoint that repairs the database depend on the worker that reads it.",
    "operationId": "admin_reimport_admin_reimport_post",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ReimportResult"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Admin Reimport"
   }
  },
