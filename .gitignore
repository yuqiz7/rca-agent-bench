.venv/
.venv-service/
__pycache__/
*.pyc

# 探针的原始请求/返回转储：本地备查用，单轮就有数百 MB（Jaeger 整条 trace
# 载荷 × 16 个 caller），是生成物不是源码，不进版本库。目录结构保留。
scripts/out/*
!scripts/out/.gitkeep

# 原语的 restart 策略暂存：apply 时写、revert 时删，属运行时状态。
scripts/state/*
!scripts/state/.gitkeep

# 证据包的三件大文件：单卡就约 10.7 MB（logs 3.1 MB + traces 7.6 MB + metrics
# 0.17 MB），76 卡约 800 MB —— 是生成物不是源码，超过入库阈值（5 MB）不进版本库。
# 入库的是每卡的 manifest.json（含五件的字节数与 sha256，可据此复算）、
# task.json（agent 的输入）、alerts.json（检测器输出）、config_diff.txt、
# topology.json 引用，以及共享的 evidence/_baseline/ 与 evidence/_shared/。
# 重建方式：scripts/evidence/pack.py（窗口见 manifest.json）。
# `**` 不是可选的：证据目录有两层（evidence/<card>/ 与
# evidence/_clean/<observe-ts>/），单星号只盖住第一层。
evidence/**/logs.jsonl
evidence/**/metrics.json
evidence/**/traces.json

# Docker secret files for the evaluation service (docker-compose.service.yml).
# The Postgres password lives here rather than in the compose file or in an
# environment variable, so this directory is the one place it exists on disk and
# it must never be the one place it exists in the history either. The Anthropic
# key is not here at all -- it comes from the VM shell environment.
secrets/

# 服务自己跑出来的证据件（docker-compose.service.yml 的 worker 写的）。
# 命名由 service/app/runner.py 的 artifact_run_id() 定：service_<日期>_<run uuid 前 8 位>。
# 不入库的理由与 scripts/out/ 一样：它们是演示与冒烟的产物，不是被 findings.md /
# README / readme_check 引用的评测证据件。把它们放进版本库会让「artifacts/agent_runs/
# 下的东西都是被引用过的数据」这条性质失效，而那条性质正是证据审计能查得动的前提。
artifacts/agent_runs/service_*/
